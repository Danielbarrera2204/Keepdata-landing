<section id="cta-form" class="py-24 bg-brand text-white">
  <div class="max-w-3xl mx-auto px-6 text-center fade-in opacity-0 translate-y-6 transition-all duration-700">
    <h2 class="text-3xl md:text-4xl font-extrabold">¿Quieres ser de los primeros en probar KeepData?</h2>
    <p class="mt-4 text-white/90 text-lg">
      Estamos construyendo una nueva forma de procesar documentos y queremos conocer a las empresas
      que podrían beneficiarse de ella.
    </p>
  </div>

  <div class="max-w-2xl mx-auto px-6 mt-12">
    <form id="lead-form" class="bg-white rounded-2xl shadow-xl p-8 grid gap-5 text-left text-navy">
      <div>
        <label for="nombre" class="block text-sm font-semibold mb-1">Nombre</label>
        <input id="nombre" name="nombre" type="text" required
          class="w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand" />
      </div>

      <div>
        <label for="empresa" class="block text-sm font-semibold mb-1">Empresa</label>
        <input id="empresa" name="empresa" type="text" required
          class="w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand" />
      </div>

      <div>
        <label for="correo" class="block text-sm font-semibold mb-1">Correo electrónico</label>
        <input id="correo" name="correo" type="email" required
          class="w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand" />
      </div>

      <div>
        <label for="cargo" class="block text-sm font-semibold mb-1">Cargo</label>
        <input id="cargo" name="cargo" type="text" required
          class="w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand" />
      </div>

      <div>
        <label for="volumen" class="block text-sm font-semibold mb-1">
          ¿Cuántas facturas procesan aproximadamente al mes?
        </label>
        <select id="volumen" name="volumen" required
          class="w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand">
          <option value="">Selecciona una opción</option>
          <option value="menos-50">Menos de 50</option>
          <option value="50-100">50 – 100</option>
          <option value="100-500">100 – 500</option>
          <option value="mas-500">Más de 500</option>
        </select>
      </div>

      <div>
        <label for="proceso" class="block text-sm font-semibold mb-1">
          ¿Cómo procesan actualmente sus facturas?
        </label>
        <textarea id="proceso" name="proceso" rows="3" required
          class="w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
      </div>

      <div>
        <label for="comentarios" class="block text-sm font-semibold mb-1">Comentarios opcionales</label>
        <textarea id="comentarios" name="comentarios" rows="2"
          class="w-full border border-gray-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
      </div>

      <button type="submit"
        class="bg-navy text-white font-semibold py-3 rounded-lg hover:bg-navy/90 transition">
        Quiero participar
      </button>
    </form>

    <div id="success-message" class="hidden bg-white text-navy rounded-2xl shadow-xl p-8 text-center">
      <h3 class="text-xl font-bold text-brand">¡Gracias por tu interés!</h3>
      <p class="mt-3 text-graytext">
        Hemos recibido tus datos. Te contactaremos cuando KeepData esté listo para su etapa piloto.
      </p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form');
  const success = document.getElementById('success-message');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Sin backend: solo mostramos confirmación visual en frontend.
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>