---
import '../styles/global.css';
import BackgroundPattern from '../components/BackgroundPattern.astro';

const { title = "KeepData | Automatización inteligente de facturas",
  description = "Automatiza el procesamiento de facturas con inteligencia artificial. Reduce tareas manuales, organiza tu información y mejora la eficiencia de tu operación con KeepData." } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="font-sans text-navy bg-white antialiased">
  <BackgroundPattern />
  <slot />
  <script src="../scripts/animations.js"></script>
  <script src="../scripts/parallax.js"></script>
</body>
</html>