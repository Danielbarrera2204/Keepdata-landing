---
const { flip = false, color = "#FFFFFF" } = Astro.props;
---
<div class={`relative ${flip ? 'rotate-180' : ''}`}>
  <svg viewBox="0 0 1440 100" class="w-full h-16 md:h-24" preserveAspectRatio="none">
    <path
      d="M0,40 C360,100 1080,0 1440,50 L1440,100 L0,100 Z"
      fill={color}
    />
  </svg>
</div>