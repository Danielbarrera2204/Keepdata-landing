<section id="inicio" class="pt-40 pb-24 bg-skylight/40 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-navy leading-tight">
        Deja de digitar facturas. <span class="text-brand">Empieza a gestionar información.</span>
      </h1>
      <p class="mt-6 text-lg text-graytext">
        KeepData utiliza inteligencia artificial para extraer y organizar la información de tus facturas,
        reduciendo el trabajo manual y ayudándote a mantener tus datos más ordenados y confiables.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#cta-form" class="bg-brand text-white px-6 py-3 rounded-lg font-semibold hover:bg-navy transition">
          Únete al piloto
        </a>
        <a href="#como-funciona" class="border border-gray-300 text-navy px-6 py-3 rounded-lg font-semibold hover:bg-white transition">
          Conoce cómo funciona
        </a>
      </div>
    </div>

    <!-- Foto real + tarjetas flotantes -->
    <div class="relative fade-in opacity-0 translate-y-6 transition-all duration-700">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl aspect-[4/5] max-w-md mx-auto">
        <img
          src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=800&q=80"
          alt="Persona de una oficina contable revisando documentos financieros"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/40 via-transparent to-transparent"></div>
      </div>

      <!-- Tarjeta flotante: documento entrante -->
      <div class="absolute -left-6 top-10 bg-white rounded-xl shadow-lg px-4 py-3 flex items-center gap-3 w-56 animate-float">
        <div class="bg-skylight rounded-lg p-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 2h9l5 5v15H6V2z" stroke="#1E4FA3" stroke-width="1.5"/><path d="M9 12h6M9 16h6" stroke="#1E4FA3" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <div>
          <p class="text-xs text-graytext">Documento recibido</p>
          <p class="text-sm font-semibold text-navy">Factura.pdf</p>
        </div>
      </div>

      <!-- Tarjeta flotante: procesamiento IA -->
      <div class="absolute -right-4 top-1/2 -translate-y-1/2 bg-navy text-white rounded-xl shadow-lg px-4 py-3 w-52 animate-float-delayed">
        <p class="text-xs text-white/70">Procesando con IA</p>
        <p class="text-sm font-semibold mt-1">Extrayendo información…</p>
        <div class="mt-2 h-1.5 bg-white/20 rounded-full overflow-hidden">
          <div class="h-full w-2/3 bg-brand rounded-full"></div>
        </div>
      </div>

      <!-- Tarjeta flotante: resultado -->
      <div class="absolute -left-6 bottom-8 bg-white rounded-xl shadow-lg px-4 py-3 flex items-center gap-3 w-60 animate-float">
        <div class="bg-brand/10 rounded-lg p-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#1E4FA3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div>
          <p class="text-xs text-graytext">Listo para exportar</p>
          <p class="text-sm font-semibold text-navy">Datos organizados</p>
        </div>
      </div>
    </div>
  </div>
</section>