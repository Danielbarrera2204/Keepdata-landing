---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WaveDivider from '../components/WaveDivider.astro';
import Problem from '../components/Problem.astro';
import Solution from '../components/Solution.astro';
import Features from '../components/Features.astro';
import Benefits from '../components/Benefits.astro';
import Security from '../components/Security.astro';
import Validation from '../components/Validation.astro';
import CtaForm from '../components/CtaForm.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Header />
  <Hero />
  <Problem />
  <Solution />
  <Features />
  <Benefits />

  <WaveDivider color="#0B1F3A" />
  <Security />
  <WaveDivider color="#EAF1FB" flip />

  <Validation />
  <CtaForm />
  <Faq />
  <Footer />
</Layout>